{
  "expo": {
    "name": "SafeRoute Pro",
    "slug": "syncforge-natively-build",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saferoutepro.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.saferoutepro.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "webAppUrl": "https://www.saferouteapp.dev/",
      "eas": {
        "projectId": "d3faa111-5db7-4549-8503-38c25bfe4b9b"
      }
    },
    "owner": "izzydc",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d3faa111-5db7-4549-8503-38c25bfe4b9b"
    }
  }
}